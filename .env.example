# Copy this file to .env.local and fill in values from
# Firebase Console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database (live chat): Firebase Console > Realtime Database > the address at the top
VITE_FIREBASE_DATABASE_URL=https://my-business-5bcad-default-rtdb.asia-southeast1.firebasedatabase.app

# Backend API (my-business-be), including the version
VITE_API_URL=http://localhost:8000/api/v1

# Local development only: use the Firebase emulators instead of the real project
# VITE_FIREBASE_EMULATORS=true

# Where the selling app (my-business-pos) is deployed; shown to owners on Team -> Sellers
VITE_POS_URL=
